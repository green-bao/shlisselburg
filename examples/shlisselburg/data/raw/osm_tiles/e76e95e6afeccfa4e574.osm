 <node id="12137726934" visible="true" version="2" changeset="155782065" timestamp="2024-08-26T13:13:03Z" user="danilshvalov" uid="16430474" lat="59.9537124" lon="31.0392471">
  <tag k="information" v="board"/>
  <tag k="inscription" v="Русские солдаты, погибшие при штурме Нотебурга 11 октября 1702 года, были похоронены в братской могиле на территории крепости. Ежегодно 11 октября на могиле служили панихиду, оглашая имена погибших петровских воинов. В дни празднования 200-летия Шлиссельб"/>
  <tag k="name" v="Братская могила солдат Семёновского и Преображенского полков"/>
  <tag k="tourism" v="information"/>
 </node>

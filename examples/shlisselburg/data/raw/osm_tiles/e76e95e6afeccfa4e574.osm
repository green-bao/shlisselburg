  <tag k="information" v="board"/>
  <tag k="inscription" v="В 1881 году правительство Александра III решило восстановить значение Шлиссельбургской крепости как одной из важнейших политических тюрем Российской империи. По проекту устройства тюрьмы, кроме собственно тюремных зданий с камерами для заключения представ"/>
  <tag k="name" v="Офицерский корпус"/>
  <tag k="tourism" v="information"/>
 </node>
